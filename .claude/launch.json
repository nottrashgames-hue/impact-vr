{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "impact-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "url": "https://localhost:5173"
    },
    {
      "name": "impact-dev-http",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:http"],
